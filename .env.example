# --- Database (required) ---------------------------------------------------
# Connection string used by the application at runtime. Resolution order:
#   ZAVRUNE_DATABASE_URL -> DATABASE_URL -> POSTGRES_URL
# If none is set the app fails closed; pg is never allowed to use localhost.
ZAVRUNE_DATABASE_URL=
DATABASE_URL=postgres://user:password@host/db?sslmode=require
POSTGRES_URL=
# Optional direct (non-pooled) connection string, used only by the migration
# runner at build time / `npm run db:migrate`. Falls back to
# POSTGRES_URL_NON_POOLING and then to the application URL above.
DATABASE_URL_UNPOOLED=

# --- Runtime behaviour (optional) ------------------------------------------
# 1 = a single bounded ping during serverless cold start. Migrations are never
# run from the instrumentation hook; the build step applies committed SQL.
ZAVRUNE_DB_WARMUP=

# --- Admin provisioning (required to use /mohamedbdr) ----------------------
# The first admin account is created from these values on the first request
# that needs it, and the password is stored as a bcrypt hash only.
ZAVRUNE_ADMIN_EMAIL=owner@example.com
ZAVRUNE_ADMIN_PASSWORD=change-me-with-10+-chars-and-digits
# Optional display name for the admin account.
ZAVRUNE_ADMIN_NAME=Store Owner
# Optional one-time token: when set, the next request rotates the admin password
# to ZAVRUNE_ADMIN_PASSWORD and revokes every existing session. Remove it from
# the environment afterwards so it cannot be replayed.
ZAVRUNE_ADMIN_RESET_TOKEN=
